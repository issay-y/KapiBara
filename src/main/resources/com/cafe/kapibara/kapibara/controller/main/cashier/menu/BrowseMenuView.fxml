<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- resources/com/cafe/kapibara/kapibara/controller/main/cashier/menu/BrowseMenuView.fxml
     Content only: the sidebar and top bar come from CashierView.fxml.

     minHeight="-Infinity" on the root VBox = "never shrink below your natural height".
     Without it, a long product list is squeezed into the window height and the
     search bar is crushed; with it the page scrolls and every control keeps its size. -->
<ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="adm-scroll"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cafe.kapibara.kapibara.controller.main.cashier.menu.BrowseMenuController">
   <VBox minHeight="-Infinity" spacing="24.0" styleClass="adm-page, adm-lg">
      <padding>
         <Insets top="32.0" right="40.0" bottom="32.0" left="40.0" />
      </padding>

      <!-- Header -->
      <HBox alignment="CENTER_LEFT">
         <VBox spacing="5.0" HBox.hgrow="ALWAYS">
            <Label styleClass="adm-page-title" text="Browse the menu" />
            <Label styleClass="adm-page-sub" text="Non-coffee favorites, fresh bakes, snacks and finishing touches." />
         </VBox>
         <Button fx:id="returnBtn" onAction="#handleReturn" styleClass="adm-primary-btn" text="Return to order" />
      </HBox>

      <!-- Search bar: pinned to 52px so it is the same size in every category -->
      <StackPane minHeight="52.0" prefHeight="52.0" maxHeight="52.0">
         <TextField fx:id="searchField" promptText="Search coffee, pastries, snacks..." styleClass="adm-search" />
         <Label mouseTransparent="true" styleClass="adm-search-icon" text="🔍" StackPane.alignment="CENTER_LEFT">
            <StackPane.margin><Insets left="18.0" /></StackPane.margin>
         </Label>
      </StackPane>

      <HBox fx:id="chipRow" minHeight="-Infinity" spacing="10.0" />

      <GridPane fx:id="productGrid" hgap="18.0" vgap="18.0" minHeight="-Infinity">
         <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
         </columnConstraints>
      </GridPane>

      <Region VBox.vgrow="ALWAYS" />

      <Label fx:id="footLabel" styleClass="adm-card-foot" text="" />
   </VBox>
</ScrollPane>
