<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- resources/com/cafe/kapibara/kapibara/controller/main/cashier/home/CashierHomeView.fxml
     Content only: the sidebar and top bar come from CashierView.fxml. -->
<ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="adm-scroll"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cafe.kapibara.kapibara.controller.main.cashier.home.CashierHomeController">
   <VBox spacing="24.0" styleClass="adm-page, adm-lg">
      <padding>
         <Insets top="32.0" right="40.0" bottom="32.0" left="40.0" />
      </padding>

      <!-- Greeting -->
      <VBox spacing="5.0">
         <Label fx:id="greetingTitle" styleClass="adm-page-title" text="Good morning." />
         <Label fx:id="greetingSub" styleClass="adm-page-sub" text="" />
      </VBox>

      <!-- Shift banner -->
      <HBox alignment="CENTER_LEFT" styleClass="csh-hero">
         <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <Label fx:id="heroDate" styleClass="csh-hero-date" text="" />
            <Label styleClass="csh-hero-title" text="Let's make it a good coffee day." />
            <Label fx:id="heroShift" styleClass="csh-hero-sub" text="" />
         </VBox>
         <Label styleClass="csh-shift-pill" text="Shift active" />
      </HBox>

      <!-- KPI row -->
      <HBox spacing="22.0">
         <VBox styleClass="adm-card, adm-kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="200.0">
            <Label styleClass="adm-kpi-label" text="Your shift sales" />
            <Label fx:id="salesValue" styleClass="adm-kpi-value" text="₱0" />
            <Label fx:id="salesSub" styleClass="adm-kpi-sub" text="" />
         </VBox>
         <VBox styleClass="adm-card, adm-kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="200.0">
            <Label styleClass="adm-kpi-label" text="Transactions" />
            <Label fx:id="txValue" styleClass="adm-kpi-value" text="0" />
            <Label fx:id="txSub" styleClass="adm-kpi-sub" text="" />
         </VBox>
         <VBox styleClass="adm-card, adm-kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="200.0">
            <Label styleClass="adm-kpi-label" text="Average order" />
            <Label fx:id="avgValue" styleClass="adm-kpi-value" text="₱0" />
            <Label fx:id="avgSub" styleClass="adm-kpi-sub" text="" />
         </VBox>
         <!-- Clicking this card jumps to the order being built -->
         <VBox onMouseClicked="#handleOpenOrder" styleClass="adm-card, adm-kpi-card, csh-clickable"
               HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="200.0">
            <Label styleClass="adm-kpi-label" text="Current order" />
            <Label fx:id="orderValue" styleClass="adm-kpi-value" text="₱0" />
            <Label fx:id="orderSub" styleClass="adm-kpi-sub" text="" />
         </VBox>
      </HBox>

      <HBox alignment="TOP_LEFT" fillHeight="true" spacing="24.0" VBox.vgrow="ALWAYS">

         <!-- ================= RECENT TRANSACTIONS ================= -->
         <VBox styleClass="adm-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="18.0">
            <Label styleClass="adm-card-title" text="Recent transactions" />

            <GridPane fx:id="txGrid" styleClass="adm-table">
               <columnConstraints>
                  <ColumnConstraints percentWidth="30.0" />
                  <ColumnConstraints percentWidth="18.0" />
                  <ColumnConstraints percentWidth="14.0" />
                  <ColumnConstraints percentWidth="20.0" />
                  <ColumnConstraints percentWidth="18.0" />
               </columnConstraints>
            </GridPane>

            <Label fx:id="txEmptyLabel" styleClass="adm-card-foot" text="No transactions yet this shift. Paid orders will show up here." wrapText="true" />

            <Region VBox.vgrow="ALWAYS" />

            <HBox>
               <Button onAction="#handleViewAll" styleClass="adm-link" text="View all transactions →" />
            </HBox>
         </VBox>

         <!-- ================= COUNTER NOTES ================= -->
         <VBox styleClass="adm-card" prefWidth="440.0" minWidth="380.0" maxWidth="440.0" spacing="20.0">
            <Label styleClass="adm-card-title" text="Counter notes" />

            <HBox fx:id="noteBanner" alignment="CENTER_LEFT" spacing="16.0" styleClass="adm-banner">
               <Label styleClass="adm-alert-icon" text="⚠" />
               <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                  <Label fx:id="noteTitle" styleClass="adm-alert-title" text="" wrapText="true" />
                  <Label fx:id="noteSub" styleClass="adm-alert-sub" text="" wrapText="true" />
               </VBox>
            </HBox>

            <Label fx:id="allGoodLabel" styleClass="adm-stock-value, adm-sub-good" text="All menu items are in stock." />

            <VBox spacing="6.0">
               <Label styleClass="adm-role-name" text="Before your next order" />
               <Label styleClass="adm-role-desc" text="Check stock badges, confirm quantities, and count the customer's change." wrapText="true" />
            </VBox>
         </VBox>
      </HBox>
   </VBox>
</ScrollPane>
