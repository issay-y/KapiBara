<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="NEVER" styleClass="adm-scroll"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cafe.kapibara.kapibara.controller.main.admin.sale.SaleController">

   <fx:define>
      <ToggleGroup fx:id="periodGroup" />
   </fx:define>

   <VBox spacing="16.0" styleClass="adm-page, adm-lg, adm-sales">
      <padding>
         <Insets top="20.0" right="40.0" bottom="20.0" left="40.0" />
      </padding>

      <HBox alignment="CENTER_LEFT">
         <VBox spacing="5.0" HBox.hgrow="ALWAYS">
            <Label styleClass="adm-page-title" text="Sales overview" />
            <Label styleClass="adm-page-sub" text="Know what's brewing. Track sales and your customers' favorites." />
         </VBox>
         <VBox alignment="CENTER_RIGHT" spacing="6.0">
            <HBox alignment="CENTER_RIGHT" spacing="8.0">
               <ToggleButton fx:id="dailyBtn" toggleGroup="$periodGroup" onAction="#handlePeriodChange" styleClass="adm-period-btn" text="Daily" selected="true" />
               <ToggleButton fx:id="weeklyBtn" toggleGroup="$periodGroup" onAction="#handlePeriodChange" styleClass="adm-period-btn" text="Weekly" />
               <ToggleButton fx:id="monthlyBtn" toggleGroup="$periodGroup" onAction="#handlePeriodChange" styleClass="adm-period-btn" text="Monthly" />
               <ToggleButton fx:id="quarterlyBtn" toggleGroup="$periodGroup" onAction="#handlePeriodChange" styleClass="adm-period-btn" text="Quarterly" />
               <ToggleButton fx:id="yearlyBtn" toggleGroup="$periodGroup" onAction="#handlePeriodChange" styleClass="adm-period-btn" text="Yearly" />
            </HBox>
            <Label fx:id="rangeLabel" styleClass="adm-chart-note" text="20 Oct 2026" />
         </VBox>
      </HBox>

      <!-- KPI row -->
      <HBox spacing="22.0">
         <VBox styleClass="adm-card, adm-kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="200.0">
            <Label fx:id="salesLabel" styleClass="adm-kpi-label" text="Today's Sales" />
            <Label fx:id="salesValue" styleClass="adm-kpi-value" text="₱0" />
            <Label fx:id="salesSub" styleClass="adm-kpi-sub" text="" />
         </VBox>
         <VBox styleClass="adm-card, adm-kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="200.0">
            <Label fx:id="prevLabel" styleClass="adm-kpi-label" text="Yesterday's Sales" />
            <Label fx:id="prevValue" styleClass="adm-kpi-value" text="₱0" />
            <Label fx:id="prevSub" styleClass="adm-kpi-sub" text="" />
         </VBox>
         <VBox styleClass="adm-card, adm-kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="200.0">
            <Label fx:id="txLabel" styleClass="adm-kpi-label" text="Total Transactions" />
            <Label fx:id="txValue" styleClass="adm-kpi-value" text="0" />
            <Label fx:id="txSub" styleClass="adm-kpi-sub" text="Today · All complete" />
         </VBox>
         <VBox styleClass="adm-card, adm-kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="200.0">
            <Label fx:id="avgLabel" styleClass="adm-kpi-label" text="Average Transaction" />
            <Label fx:id="avgValue" styleClass="adm-kpi-value" text="₱0" />
            <Label fx:id="avgSub" styleClass="adm-kpi-sub" text="" />
         </VBox>
         <VBox styleClass="adm-card, adm-kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="200.0">
            <Label fx:id="topLabel" styleClass="adm-kpi-label" text="Most Sold Product" />
            <Label fx:id="topProductValue" styleClass="adm-kpi-value-text" text="—" />
            <Label fx:id="topProductSub" styleClass="adm-kpi-sub" text="" />
         </VBox>
      </HBox>

      <!-- Sales performance + best sellers -->
      <HBox spacing="22.0" VBox.vgrow="ALWAYS" prefHeight="290.0" minHeight="250.0">
         <VBox styleClass="adm-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="2.0">
            <VBox spacing="2.0">
               <Label styleClass="adm-card-title" text="Sales performance" />
               <Label fx:id="perfSubtitle" styleClass="adm-card-sub" text="₱0 total" />
            </VBox>
            <Label fx:id="perfScaleLabel" styleClass="adm-chart-note" text="PHP" />
            <BarChart fx:id="perfChart" legendVisible="false" animated="false" categoryGap="16.0" barGap="0.0"
                      horizontalGridLinesVisible="false" verticalGridLinesVisible="false"
                      horizontalZeroLineVisible="false" verticalZeroLineVisible="false"
                      alternativeColumnFillVisible="false" alternativeRowFillVisible="false" VBox.vgrow="ALWAYS">
               <xAxis>
                  <CategoryAxis side="BOTTOM" tickMarkVisible="false" />
               </xAxis>
               <yAxis>
                  <NumberAxis side="LEFT" tickLabelsVisible="false" tickMarkVisible="false" minorTickVisible="false" />
               </yAxis>
            </BarChart>
         </VBox>

         <VBox styleClass="adm-card" prefWidth="420.0" minWidth="360.0" maxWidth="420.0" spacing="14.0">
            <Label fx:id="bestSellersTitle" styleClass="adm-card-title" text="Today's best sellers" />
            <VBox fx:id="bestSellersBox" spacing="14.0" />
            <Region VBox.vgrow="ALWAYS" />
            <Label fx:id="bestSellersFooter" styleClass="adm-card-foot" text="" />
         </VBox>
      </HBox>

      <!-- Bottom charts -->
      <HBox spacing="22.0" VBox.vgrow="ALWAYS" prefHeight="230.0" minHeight="210.0">
         <VBox styleClass="adm-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="400.0" spacing="2.0">
            <Label fx:id="hourlyTitle" styleClass="adm-card-title" text="Hourly sales" />
            <Label fx:id="hourlyNote" styleClass="adm-chart-note" text="PHP" />
            <BarChart fx:id="hourlyChart" legendVisible="false" animated="false" categoryGap="16.0" barGap="0.0"
                      horizontalGridLinesVisible="false" verticalGridLinesVisible="false"
                      horizontalZeroLineVisible="false" verticalZeroLineVisible="false"
                      alternativeColumnFillVisible="false" alternativeRowFillVisible="false" VBox.vgrow="ALWAYS">
               <xAxis>
                  <CategoryAxis side="BOTTOM" tickMarkVisible="false" />
               </xAxis>
               <yAxis>
                  <NumberAxis side="LEFT" tickLabelsVisible="false" tickMarkVisible="false" minorTickVisible="false" />
               </yAxis>
            </BarChart>
            <Label fx:id="hourlyFooter" styleClass="adm-card-foot" text="" />
         </VBox>

         <VBox styleClass="adm-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="400.0" spacing="2.0">
            <Label fx:id="trendTitle" styleClass="adm-card-title" text="Trend" />
            <Label fx:id="trendNote" styleClass="adm-chart-note" text="PHP" />
            <BarChart fx:id="trendChart" legendVisible="false" animated="false" categoryGap="16.0" barGap="0.0"
                      horizontalGridLinesVisible="false" verticalGridLinesVisible="false"
                      horizontalZeroLineVisible="false" verticalZeroLineVisible="false"
                      alternativeColumnFillVisible="false" alternativeRowFillVisible="false" VBox.vgrow="ALWAYS">
               <xAxis>
                  <CategoryAxis side="BOTTOM" tickMarkVisible="false" />
               </xAxis>
               <yAxis>
                  <NumberAxis side="LEFT" tickLabelsVisible="false" tickMarkVisible="false" minorTickVisible="false" />
               </yAxis>
            </BarChart>
            <Label fx:id="trendFooter" styleClass="adm-card-foot" text="" />
         </VBox>
      </HBox>
   </VBox>
</ScrollPane>