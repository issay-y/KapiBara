<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- resources/com/cafe/kapibara/kapibara/controller/main/cashier/CashierView.fxml
     The cashier shell: sidebar + top bar. Pages are loaded into contentHolder.
     Reuses the adm- classes from AdminShell.css; Cashier.css adds the csh- classes. -->
<BorderPane fx:id="root" styleClass="adm-root"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cafe.kapibara.kapibara.controller.main.cashier.CashierController">
   <stylesheets>
      <URL value="@/com/cafe/kapibara/kapibara/css/main/admin/AdminShell.css" />
      <URL value="@/com/cafe/kapibara/kapibara/css/main/cashier/Cashier.css" />
   </stylesheets>

   <!-- ================= SIDEBAR ================= -->
   <left>
      <VBox minWidth="230.0" maxWidth="230.0" prefWidth="230.0" spacing="6.0" styleClass="adm-sidebar">
         <padding>
            <Insets top="22.0" right="16.0" bottom="16.0" left="16.0" />
         </padding>

         <ImageView fx:id="sidebarLogo" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" />
         <Label styleClass="adm-side-brand" text="KapiBara" />
         <Label styleClass="adm-side-tagline" text="COFFEE SHOP • EST. 2024" />
         <HBox>
            <VBox.margin><Insets top="10.0" bottom="14.0" /></VBox.margin>
            <Label styleClass="adm-badge, csh-badge" text="Cashier workspace" />
         </HBox>

         <Button fx:id="navHome" maxWidth="Infinity" onAction="#handleNav" styleClass="adm-nav" text="▦   Home" />
         <Button fx:id="navNewOrder" maxWidth="Infinity" onAction="#handleNav" styleClass="adm-nav" text="☕   New Order" />
         <Button fx:id="navTransactions" maxWidth="Infinity" onAction="#handleTransactions" styleClass="adm-nav" text="▤   Transactions" />

         <Region VBox.vgrow="ALWAYS" />

         <Button fx:id="navLogout" maxWidth="Infinity" onAction="#handleLogout" styleClass="adm-nav" text="⇥   Logout" />
         <Label styleClass="adm-side-version" text="KapiBara v1.0 • Caloocan">
            <VBox.margin><Insets top="10.0" /></VBox.margin>
         </Label>
      </VBox>
   </left>

   <!-- ================= TOP BAR ================= -->
   <top>
      <HBox alignment="CENTER_LEFT" minHeight="54.0" prefHeight="54.0" spacing="18.0" styleClass="adm-topbar">
         <padding>
            <Insets right="28.0" left="28.0" />
         </padding>
         <Label fx:id="breadcrumbLabel" styleClass="adm-breadcrumb" text="Caloocan branch / Home" />
         <Region HBox.hgrow="ALWAYS" />
         <Label fx:id="dateLabel" styleClass="adm-topbar-date" text="" />
         <Label styleClass="adm-bell" text="🔔" />
         <Label fx:id="userLabel" styleClass="adm-topbar-user" text="User · Cashier  ▾" />
      </HBox>
   </top>

   <!-- ================= PAGE ================= -->
   <center>
      <StackPane fx:id="contentHolder" styleClass="adm-content-holder" />
   </center>
</BorderPane>
