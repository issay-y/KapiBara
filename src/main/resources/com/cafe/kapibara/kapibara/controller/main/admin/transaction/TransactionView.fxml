<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- resources/com/cafe/kapibara/kapibara/controller/main/admin/transaction/TransactionView.fxml
     Content only: the sidebar and top bar come from AdminView.fxml. -->
<ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="adm-scroll"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cafe.kapibara.kapibara.controller.main.admin.transaction.TransactionController">
   <VBox spacing="24.0" styleClass="adm-page, adm-lg, adm-tx">
      <padding>
         <Insets top="32.0" right="40.0" bottom="32.0" left="40.0" />
      </padding>

      <!-- Header: title on the left, Back to Home on the top right -->
      <HBox alignment="CENTER_LEFT">
         <VBox spacing="5.0" HBox.hgrow="ALWAYS">
            <Label styleClass="adm-page-title" text="Transactions" />
            <Label styleClass="adm-page-sub" text="A clear record of every completed counter order." />
         </VBox>
         <Button onAction="#handleBack" styleClass="adm-primary-btn" text="←   Back to Home" />
      </HBox>

      <!-- Filters
           Every control is pinned to 52px so the search bar, the three
           combo boxes and the sort button share the same top and bottom edge. -->
      <HBox alignment="BOTTOM_LEFT" spacing="16.0">
         <StackPane HBox.hgrow="ALWAYS" minHeight="52.0" prefHeight="52.0" maxHeight="52.0">
            <TextField fx:id="searchField" promptText="Search transaction number or cashier..." styleClass="adm-search" />
            <Label mouseTransparent="true" styleClass="adm-search-icon" text="🔍" StackPane.alignment="CENTER_LEFT">
               <StackPane.margin><Insets left="18.0" /></StackPane.margin>
            </Label>
         </StackPane>
         <VBox spacing="8.0">
            <Label styleClass="adm-filter-label" text="Date Filter" />
            <ComboBox fx:id="dateCombo" minHeight="52.0" prefHeight="52.0" prefWidth="230.0" styleClass="adm-combo" />
         </VBox>
         <VBox spacing="8.0">
            <Label styleClass="adm-filter-label" text="Payment" />
            <ComboBox fx:id="paymentCombo" minHeight="52.0" prefHeight="52.0" prefWidth="270.0" styleClass="adm-combo" />
         </VBox>
         <VBox spacing="8.0">
            <Label styleClass="adm-filter-label" text="Status" />
            <ComboBox fx:id="statusCombo" minHeight="52.0" prefHeight="52.0" prefWidth="250.0" styleClass="adm-combo" />
         </VBox>
         <Button fx:id="sortBtn" minHeight="52.0" onAction="#handleSort" prefHeight="52.0" styleClass="adm-outline-btn" text="⇅   Newest first" />
      </HBox>

      <!-- Table -->
      <GridPane fx:id="txGrid" styleClass="adm-table">
         <columnConstraints>
            <ColumnConstraints percentWidth="19.0" />
            <ColumnConstraints percentWidth="11.0" />
            <ColumnConstraints percentWidth="15.0" />
            <ColumnConstraints percentWidth="8.0" />
            <ColumnConstraints percentWidth="12.0" />
            <ColumnConstraints percentWidth="11.0" />
            <ColumnConstraints percentWidth="13.0" />
            <ColumnConstraints percentWidth="11.0" />
         </columnConstraints>
      </GridPane>

      <Region VBox.vgrow="ALWAYS" />

      <!-- Footer: count + pagination -->
      <HBox alignment="CENTER_LEFT">
         <Label fx:id="showingLabel" styleClass="adm-card-foot" text="" />
         <Region HBox.hgrow="ALWAYS" />
         <HBox fx:id="paginationBox" alignment="CENTER_RIGHT" spacing="8.0" />
      </HBox>

      <HBox alignment="CENTER_LEFT">
         <Label styleClass="adm-card-foot" text="All transactions are cash payments. Totals include VAT." />
         <Region HBox.hgrow="ALWAYS" />
         <Label fx:id="todayLabel" styleClass="adm-foot-total" text="" />
      </HBox>
   </VBox>
</ScrollPane>
