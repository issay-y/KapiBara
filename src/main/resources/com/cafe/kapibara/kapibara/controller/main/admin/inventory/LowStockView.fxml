<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- resources/com/cafe/kapibara/kapibara/controller/main/admin/inventory/LowStockView.fxml
     Content only: the sidebar and top bar come from AdminView.fxml. -->
<ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="adm-scroll"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cafe.kapibara.kapibara.controller.main.admin.inventory.LowStockController">
   <VBox spacing="16.0" styleClass="adm-page">
      <padding>
         <Insets top="24.0" right="28.0" bottom="24.0" left="28.0" />
      </padding>

      <!-- Header -->
      <HBox alignment="CENTER_LEFT">
         <VBox spacing="3.0" HBox.hgrow="ALWAYS">
            <Label styleClass="adm-page-title" text="Low stock priorities" />
            <Label styleClass="adm-page-sub" text="Restock the right items before they slow down your café." />
         </VBox>
         <Button onAction="#handleBack" styleClass="adm-primary-btn" text="←   Back to inventory" />
      </HBox>

      <!-- KPI row -->
      <HBox spacing="14.0">
         <VBox styleClass="adm-card, adm-kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="200.0">
            <Label styleClass="adm-kpi-label" text="Needs attention" />
            <Label fx:id="needsValue" styleClass="adm-kpi-value" text="6 items" />
            <Label fx:id="needsSub" styleClass="adm-kpi-sub" text="4 low stock + 2 out of stock" />
         </VBox>
         <VBox styleClass="adm-card, adm-kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="200.0">
            <Label styleClass="adm-kpi-label" text="Critical / unavailable" />
            <Label fx:id="criticalValue" styleClass="adm-kpi-value" text="3 items" />
            <Label fx:id="criticalSub" styleClass="adm-kpi-sub, adm-sub-bad" text="" />
         </VBox>
         <VBox styleClass="adm-card, adm-kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="200.0">
            <Label styleClass="adm-kpi-label" text="Last stock review" />
            <Label fx:id="reviewValue" styleClass="adm-kpi-value" text="10:20 AM" />
            <Label fx:id="reviewSub" styleClass="adm-kpi-sub" text="" />
         </VBox>
      </HBox>

      <!-- Banner -->
      <HBox fx:id="alertBanner" alignment="CENTER_LEFT" spacing="12.0" styleClass="adm-banner">
         <Label styleClass="adm-alert-icon" text="⚠" />
         <VBox spacing="2.0">
            <Label fx:id="alertTitle" styleClass="adm-alert-title" text="Restock unavailable items first" />
            <Label fx:id="alertSub" styleClass="adm-alert-sub" text="" />
         </VBox>
      </HBox>

      <!-- Filters -->
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <StackPane HBox.hgrow="ALWAYS">
            <TextField fx:id="searchField" promptText="Search low-stock items..." styleClass="adm-search" />
            <Label mouseTransparent="true" styleClass="adm-search-icon" text="🔍" StackPane.alignment="CENTER_LEFT">
               <StackPane.margin><Insets left="14.0" /></StackPane.margin>
            </Label>
         </StackPane>
         <ComboBox fx:id="categoryCombo" prefWidth="190.0" styleClass="adm-combo" />
      </HBox>

      <!-- Table -->
      <GridPane fx:id="lowStockGrid" styleClass="adm-table">
         <columnConstraints>
            <ColumnConstraints percentWidth="26.0" />
            <ColumnConstraints percentWidth="12.0" />
            <ColumnConstraints percentWidth="12.0" />
            <ColumnConstraints percentWidth="12.0" />
            <ColumnConstraints percentWidth="16.0" />
            <ColumnConstraints percentWidth="22.0" />
         </columnConstraints>
      </GridPane>

      <Label styleClass="adm-card-foot" text="Gold indicates low stock. Red indicates critical or out-of-stock items." />
   </VBox>
</ScrollPane>
