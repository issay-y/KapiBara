<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- resources/com/cafe/kapibara/kapibara/controller/main/cashier/receipt/ReceiptView.fxml
     Content only: the sidebar and top bar come from CashierView.fxml. -->
<ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="adm-scroll"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cafe.kapibara.kapibara.controller.main.cashier.receipt.ReceiptController">
   <VBox spacing="24.0" styleClass="adm-page, adm-lg">
      <padding>
         <Insets top="32.0" right="40.0" bottom="32.0" left="40.0" />
      </padding>

      <!-- Header -->
      <VBox spacing="5.0">
         <Label styleClass="adm-page-title" text="Payment complete" />
         <Label styleClass="adm-page-sub" text="Your transaction is complete. Here's the customer's virtual receipt." />
      </VBox>

      <HBox alignment="CENTER" fillHeight="false" spacing="56.0" VBox.vgrow="ALWAYS">

         <!-- ================= RECEIPT ================= -->
         <VBox prefWidth="540.0" minWidth="460.0" maxWidth="540.0" spacing="12.0" styleClass="csh-receipt">
            <Label alignment="CENTER" maxWidth="Infinity" styleClass="csh-receipt-brand" text="KapiBara" />
            <Label fx:id="branchLabel" alignment="CENTER" maxWidth="Infinity" styleClass="csh-receipt-sub" text="" />
            <Label fx:id="addressLabel" alignment="CENTER" maxWidth="Infinity" styleClass="csh-receipt-sub" text="" />
            <HBox alignment="CENTER">
               <Label styleClass="adm-pill-green" text="PAID • CASH" />
            </HBox>

            <Region maxHeight="1.0" minHeight="1.0" prefHeight="1.0" styleClass="adm-divider" />

            <HBox alignment="CENTER_LEFT">
               <Label styleClass="adm-stock-name" text="Transaction" />
               <Region HBox.hgrow="ALWAYS" />
               <Label fx:id="numberLabel" styleClass="csh-receipt-val" text="" />
            </HBox>
            <HBox alignment="CENTER_LEFT">
               <Label styleClass="adm-stock-name" text="Date &amp; time" />
               <Region HBox.hgrow="ALWAYS" />
               <Label fx:id="timeLabel" styleClass="csh-receipt-val" text="" />
            </HBox>
            <HBox alignment="CENTER_LEFT">
               <Label styleClass="adm-stock-name" text="Cashier" />
               <Region HBox.hgrow="ALWAYS" />
               <Label fx:id="cashierLabel" styleClass="csh-receipt-val" text="" />
            </HBox>

            <Region maxHeight="1.0" minHeight="1.0" prefHeight="1.0" styleClass="adm-divider" />

            <HBox alignment="CENTER_LEFT">
               <Label styleClass="csh-receipt-head" text="ITEM / QTY × UNIT PRICE" />
               <Region HBox.hgrow="ALWAYS" />
               <Label styleClass="csh-receipt-head" text="AMOUNT" />
            </HBox>

            <VBox fx:id="linesBox" spacing="14.0" />

            <Region maxHeight="1.0" minHeight="1.0" prefHeight="1.0" styleClass="adm-divider" />

            <HBox alignment="CENTER_LEFT">
               <Label styleClass="adm-stock-name" text="Subtotal (VAT-exclusive)" />
               <Region HBox.hgrow="ALWAYS" />
               <Label fx:id="subtotalLabel" styleClass="adm-stock-value" text="" />
            </HBox>
            <HBox alignment="CENTER_LEFT">
               <Label fx:id="vatCaption" styleClass="adm-stock-name" text="VAT (12%, included)" />
               <Region HBox.hgrow="ALWAYS" />
               <Label fx:id="vatLabel" styleClass="adm-stock-value" text="" />
            </HBox>
            <HBox alignment="CENTER_LEFT">
               <Label fx:id="discountCaption" styleClass="adm-stock-name" text="Discount" />
               <Region HBox.hgrow="ALWAYS" />
               <Label fx:id="discountLabel" styleClass="adm-stock-value" text="" />
            </HBox>

            <Region maxHeight="2.0" minHeight="2.0" prefHeight="2.0" styleClass="adm-divider" />

            <HBox alignment="CENTER_LEFT">
               <Label styleClass="csh-total-label" text="Total" />
               <Region HBox.hgrow="ALWAYS" />
               <Label fx:id="totalLabel" styleClass="csh-total-value" text="" />
            </HBox>

            <Region maxHeight="1.0" minHeight="1.0" prefHeight="1.0" styleClass="adm-divider" />

            <HBox alignment="CENTER_LEFT">
               <Label styleClass="adm-stock-name" text="Cash received" />
               <Region HBox.hgrow="ALWAYS" />
               <Label fx:id="cashLabel" styleClass="csh-receipt-val" text="" />
            </HBox>
            <HBox alignment="CENTER_LEFT">
               <Label styleClass="adm-stock-name" text="Change" />
               <Region HBox.hgrow="ALWAYS" />
               <Label fx:id="changeLabel" styleClass="csh-receipt-val" text="" />
            </HBox>

            <Region maxHeight="1.0" minHeight="1.0" prefHeight="1.0" styleClass="adm-divider" />

            <Label alignment="CENTER" maxWidth="Infinity" styleClass="csh-receipt-thanks" text="Salamat! See you for another cup." />
            <Label alignment="CENTER" maxWidth="Infinity" styleClass="csh-receipt-sub" text="Virtual receipt • No printing required" />
         </VBox>

         <!-- ================= WHAT NEXT ================= -->
         <VBox prefWidth="480.0" minWidth="420.0" maxWidth="480.0" spacing="14.0">
            <VBox styleClass="adm-card" spacing="16.0">
               <StackPane styleClass="csh-check-circle">
                  <Label styleClass="csh-check-mark" text="✓" />
               </StackPane>
               <Label styleClass="csh-done-title" text="Another good order." />
               <Label fx:id="summaryLabel" styleClass="adm-role-desc" text="" wrapText="true" />

               <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="csh-status, csh-status-ok">
                  <Label styleClass="csh-status-icon" text="✓" />
                  <Label fx:id="changeBanner" styleClass="csh-status-title" text="" wrapText="true" />
               </HBox>

               <Button maxWidth="Infinity" onAction="#handleNewOrder" styleClass="adm-primary-btn" text="＋   New Order" />
               <Button maxWidth="Infinity" onAction="#handleViewTransaction" styleClass="adm-outline-btn" text="▤   View Transaction" />
               <Button maxWidth="Infinity" onAction="#handleClose" styleClass="csh-close-btn" text="Close" />
            </VBox>
            <Label styleClass="adm-card-foot" text="Transaction details remain available in your history." />
         </VBox>
      </HBox>
   </VBox>
</ScrollPane>
